<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="ucp_idempotency_keys" resource="default" engine="innodb" comment="UCP Idempotency Keys Table">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="key" nullable="false" length="255" comment="Idempotency Key"/>
        <column xsi:type="varchar" name="request_hash" nullable="false" length="255" comment="Request Hash"/>
        <column xsi:type="varchar" name="response_status" nullable="true" length="50" comment="Response Status"/>
        <column xsi:type="text" name="response_body" nullable="true" comment="Response Body"/>
        <column xsi:type="datetime" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="datetime" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="UCP_IDEMPOTENCY_KEYS_KEY">
            <column name="key"/>
        </constraint>
        <index referenceId="UCP_IDEMPOTENCY_KEYS_REQUEST_HASH_IDX" indexType="btree">
            <column name="request_hash"/>
        </index>
    </table>
</schema>
