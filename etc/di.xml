<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Idempotency Key -->
    <preference for="Magebit\UniversalCommerce\Api\Data\IdempotencyKeyInterface" type="Magebit\UniversalCommerce\Model\IdempotencyKey\Model" />
    <preference for="Magebit\UniversalCommerce\Api\IdempotencyKeyRepositoryInterface" type="Magebit\UniversalCommerce\Model\IdempotencyKey\Repository" />

    <!-- Service registry -->
    <type name="Magebit\UniversalCommerce\Model\Discovery\ServiceRegistry">
        <arguments>
            <argument name="services" xsi:type="array">
                <item name="dev.ucp.shopping" xsi:type="object">Magebit\UniversalCommerce\Model\Service\Shopping\ShoppingService</item>
            </argument>
        </arguments>
    </type>

    <!-- Shopping service -->
    <preference for="Magebit\UniversalCommerce\Api\Service\Shopping\RestHandlerInterface" type="Magebit\UniversalCommerce\Model\Service\Shopping\Rest\Handler" />

    <type name="Magebit\UniversalCommerce\Model\Service\Shopping\ShoppingService">
        <arguments>
            <argument name="capabilities" xsi:type="array">
                <item name="dev.ucp.shopping.checkout" xsi:type="object">Magebit\UniversalCommerce\Model\Service\Shopping\Capability\CheckoutCapability</item>
            </argument>
        </arguments>
    </type>
    <type name="Magebit\UniversalCommerce\Model\Service\Shopping\Converter\QuoteToTotalsResponse">
        <arguments>
            <argument name="typeMapping" xsi:type="array">
                <item name="subtotal" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_SUBTOTAL</item>
                <item name="discount" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_DISCOUNT</item>
                <item name="shipping" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_FULFILLMENT</item>
                <item name="tax" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_TAX</item>
                <item name="grand_total" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_TOTAL</item>
            </argument>
        </arguments>
    </type>

    <!-- Specification implementations -->
    <!-- Discovery -->
    <preference for="Magebit\UcpSpec\Api\Discovery\UCPDiscoveryProfileInterface" type="Magebit\UniversalCommerce\Model\Spec\Discovery\UcpDiscoveryProfile" />

    <!-- Schemas -->
    <preference for="Magebit\UcpSpec\Api\Schemas\UcpDiscoveryProfileInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\UcpDiscoverProfile" />
    <preference for="Magebit\UcpSpec\Api\Schemas\CapabilityDiscoveryInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\CapabilityDiscovery" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\CapabilityResponseInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\CapabilityResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\UcpResponseCheckoutInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\UcpResponseCheckout" />

    <!-- Services -->
    <preference for="Magebit\UcpSpec\Api\Services\UCPServiceInterface" type="Magebit\UniversalCommerce\Model\Spec\Services\UcpService" />
    <preference for="Magebit\UcpSpec\Api\Services\UCPServiceRestInterface" type="Magebit\UniversalCommerce\Model\Spec\Services\UcpServiceRest" />

    <!-- Shopping - Checkout -->
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\CheckoutCreateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\CheckoutCreateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\CheckoutUpdateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\CheckoutUpdateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\CheckoutResponseInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\CheckoutResponse" />

    <!-- Shopping - Payment -->
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\PaymentCreateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\PaymentCreateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\PaymentUpdateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\PaymentUpdateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\PaymentResponseInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\PaymentResponse" />

    <!-- Shopping - Types -->
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\BuyerInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\Buyer" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\ItemCreateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\ItemCreateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\ItemUpdateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\ItemUpdateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\LineItemCreateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\LineItemCreateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\LineItemUpdateRequestInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\LineItemUpdateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\PaymentInstrumentInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\PaymentInstrument" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\ItemResponseInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\ItemResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\LineItemResponseInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\LineItemResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\LinkInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\Link" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\MessageInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\Message" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\OrderConfirmationInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\OrderConfirmation" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\PaymentHandlerResponseInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\PaymentHandlerResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface" type="Magebit\UniversalCommerce\Model\Spec\Schemas\Shopping\Types\TotalResponse" />
</config>
