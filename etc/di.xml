<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Config preferences -->
    <preference for="Magebit\UniversalCommerce\Api\ConfigInterface" type="Magebit\UniversalCommerce\Model\Config" />

    <!-- Discovery preferences -->
    <preference for="Magebit\UniversalCommerce\Api\Discovery\UcpDiscoveryProfileInterface" type="Magebit\UniversalCommerce\Model\Discovery\UcpDiscoveryProfile" />

    <!-- Idempotency preferences -->
    <preference for="Magebit\UniversalCommerce\Api\Data\IdempotencyKeyInterface" type="Magebit\UniversalCommerce\Model\IdempotencyKey\Model" />
    <preference for="Magebit\UniversalCommerce\Api\IdempotencyKeyRepositoryInterface" type="Magebit\UniversalCommerce\Model\IdempotencyKey\Repository" />

    <!-- Response preferences -->
    <preference for="Magebit\UniversalCommerce\Api\Data\Response\ErrorResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Response\ErrorResponse" />
    <preference for="Magebit\UniversalCommerce\Api\Data\Response\MessageInterface" type="Magebit\UniversalCommerce\Model\Data\Response\Message" />

    <!-- Spec data preferences-->
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\BuyerInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\Buyer" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\CheckoutCreateRequestInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\CheckoutCreateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\CheckoutUpdateRequestInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\CheckoutUpdateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\ItemCreateRequestInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\ItemCreateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\ItemUpdateRequestInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\ItemUpdateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\LineItemCreateRequestInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\LineItemCreateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\LineItemUpdateRequestInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\LineItemUpdateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\PaymentCreateRequestInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\PaymentCreateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\PaymentUpdateRequestInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\PaymentUpdateRequest" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\PaymentDataInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\PaymentData" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\PaymentCredentialInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\PaymentCredential" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\CardCredentialInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\PaymentCredential" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\PaymentInstrumentInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\PaymentInstrument" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\PostalAddressInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\PostalAddress" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\CheckoutResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\CheckoutResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\LinkInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\Link" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\MessageInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\Message" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\ItemResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\ItemResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\TotalResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\CapabilityResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\CapabilityResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\PaymentHandlerResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\PaymentHandlerResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\LineItemResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\LineItemResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\PaymentResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\PaymentResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\PlatformConfigInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\PlatformConfig" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\UcpResponseCheckoutInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\UcpResponseCheckout" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\FulfillmentResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\FulfillmentResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\FulfillmentOptionResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\FulfillmentOptionResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\FulfillmentGroupResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\FulfillmentGroupResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\FulfillmentDestinationResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\FulfillmentDestinationResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\FulfillmentAvailableMethodResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\FulfillmentAvailableMethodResponse" />
    <preference for="Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\FulfillmentMethodResponseInterface" type="Magebit\UniversalCommerce\Model\Data\Spec\Schemas\Shopping\Types\FulfillmentMethodResponse" />

    <!-- Quote to Totals Response Converter Configuration -->
    <type name="Magebit\UniversalCommerce\Model\Convert\QuoteToTotalsResponse">
        <arguments>
            <argument name="typeMapping" xsi:type="array">
                <item name="subtotal" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_SUBTOTAL</item>
                <item name="discount" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_DISCOUNT</item>
                <item name="shipping" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_FULFILLMENT</item>
                <item name="tax" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_TAX</item>
                <item name="grand_total" xsi:type="const">\Magebit\UcpSpec\MutableApi\Schemas\Shopping\Types\TotalResponseInterface::TYPE_TOTAL</item>
            </argument>
        </arguments>
    </type>

    <type name="Magebit\UniversalCommerce\Model\Discovery\UcpDiscoveryProfile">
        <arguments>
            <argument name="capabilities" xsi:type="array">
                <item name="checkout" xsi:type="object">Magebit\UniversalCommerce\Model\Discovery\CheckoutCapability</item>
            </argument>

            <argument name="services" xsi:type="array">
                <item name="shopping" xsi:type="object">Magebit\UniversalCommerce\Model\Discovery\ShoppingService</item>
            </argument>

            <argument name="paymentHandlers" xsi:type="array">
                <item name="mock" xsi:type="object">Magebit\UniversalCommerce\Model\Payment\MockPaymentHandler</item>
            </argument>
        </arguments>
    </type>

    <!-- Quote Validator Configuration -->
    <preference for="Magebit\UniversalCommerce\Api\QuoteValidatorInterface" type="Magebit\UniversalCommerce\Model\Validation\QuoteValidatorComposite" />

    <type name="Magebit\UniversalCommerce\Model\Validation\QuoteValidatorComposite">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="buyer" xsi:type="object">Magebit\UniversalCommerce\Model\Validation\BuyerValidator</item>
                <item name="line_items" xsi:type="object">Magebit\UniversalCommerce\Model\Validation\LineItemsValidator</item>
            </argument>
        </arguments>
    </type>

    <!-- Router Configuration -->
    <type name="Magebit\UniversalCommerce\Controller\Router">
        <arguments>
            <argument name="routes" xsi:type="array">
                <item name="discovery" xsi:type="array">
                    <item name="path" xsi:type="string">.well-known/ucp</item>
                    <item name="method" xsi:type="string">GET</item>
                    <item name="controller" xsi:type="string">discovery</item>
                    <item name="action" xsi:type="string">index</item>
                </item>
                <item name="create_checkout_session" xsi:type="array">
                    <item name="path" xsi:type="string">ucp/checkout-sessions</item>
                    <item name="method" xsi:type="string">POST</item>
                    <item name="controller" xsi:type="string">checkout_sessions</item>
                    <item name="action" xsi:type="string">index</item>
                </item>
                <item name="get_checkout_session" xsi:type="array">
                    <item name="path" xsi:type="string">ucp/checkout-sessions/{id}</item>
                    <item name="method" xsi:type="string">GET</item>
                    <item name="controller" xsi:type="string">checkout_sessions</item>
                    <item name="action" xsi:type="string">retrieve</item>
                </item>
                <item name="update_checkout_session" xsi:type="array">
                    <item name="path" xsi:type="string">ucp/checkout-sessions/{id}</item>
                    <item name="method" xsi:type="string">PUT</item>
                    <item name="controller" xsi:type="string">checkout_sessions</item>
                    <item name="action" xsi:type="string">update</item>
                </item>
                <item name="cancel_checkout_session" xsi:type="array">
                    <item name="path" xsi:type="string">ucp/checkout-sessions/{id}/cancel</item>
                    <item name="method" xsi:type="string">POST</item>
                    <item name="controller" xsi:type="string">checkout_sessions</item>
                    <item name="action" xsi:type="string">cancel</item>
                </item>
                <item name="complete_checkout_session" xsi:type="array">
                    <item name="path" xsi:type="string">ucp/checkout-sessions/{id}/complete</item>
                    <item name="method" xsi:type="string">POST</item>
                    <item name="controller" xsi:type="string">checkout_sessions</item>
                    <item name="action" xsi:type="string">complete</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
